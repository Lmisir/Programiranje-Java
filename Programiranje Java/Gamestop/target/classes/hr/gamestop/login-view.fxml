<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hr.gamestop.controller.LoginController">
   <children>
      <VBox alignment="CENTER" fillWidth="false" prefHeight="400.0" prefWidth="600.0" spacing="12.0">
         <children>
            <Label text="GAMESTOP MANAGER" />
            <Label text="Korisničko ime:" />
            <TextField fx:id="usernameField" minWidth="250.0" promptText="Unesite korisničko ime" />
            <Label text="Lozinka" />
            <PasswordField fx:id="passwordField" promptText="Unesite lozinku" />
            <Button mnemonicParsing="false" onAction="#onLogin" text="Prijava" />
            <Label fx:id="messageLabel" />
         </children>
      </VBox>
   </children>
</AnchorPane>
